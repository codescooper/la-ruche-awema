#!/usr/bin/env python3
"""awema-secret — client du coffre de secrets par profil (CP-03, correction P0-4).

Le client ne lit JAMAIS un fichier de secret : il passe obligatoirement par le
service `awema-vaultd` (socket Unix). En l'absence de service, il refuse
(fail-closed) — il n'existe aucun mode de lecture directe.

Commandes :
  status                      etat du service et regles appliquees
  get    --secret ID          lit une valeur (autorisation + journal)
  list                        inventaire masque (aucune valeur)
  put    --secret ID --from F provisionne (proprietaire)
  rotate --secret ID --from F rotation versionnee
  revoke --secret ID --version N
  grant  --secret ID --to P [--ttl S]
  revoke-grant --secret ID --to P
  verify                      controle d'integrite et de cloisonnement du coffre
  inventaire-live             inventaire masque du disque reel (lecture seule, sans valeur)
  hygiene-live                cloisonnement des .env et secrets hors coffre (lecture seule)
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import socket
import stat
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import awema_secret_lib as V  # noqa: E402

MOTIFS_SENSIBLES = ("api_key", "apikey", "token", "secret", "password", "passwd",
                    "private_key", "credential", "access_token", "service_role")


class RefusClient(Exception):
    pass


def chemin_socket(root) -> Path:
    return Path(os.environ.get("AWEMA_VAULT_SOCKET") or (Path(root) / "data/vault/vault.sock"))


def requete(root, charge, timeout=15.0) -> dict:
    sp = chemin_socket(root)
    if not sp.exists():
        raise RefusClient(
            f"coffre indisponible : service absent ({sp}) — aucun mode de lecture directe (fail-closed)")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(str(sp))
        s.sendall((json.dumps(charge, ensure_ascii=False) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            bloc = s.recv(65536)
            if not bloc:
                break
            buf += bloc
    except (OSError, socket.timeout) as exc:
        raise RefusClient(f"coffre injoignable ({exc}) — action refusee")
    finally:
        s.close()
    if not buf.strip():
        raise RefusClient("coffre sans reponse — action refusee")
    try:
        return json.loads(buf.decode("utf-8").splitlines()[0])
    except json.JSONDecodeError:
        raise RefusClient("reponse du coffre illisible — action refusee")


def charge_de_base(args, op) -> dict:
    profil = args.profil or os.environ.get("AWEMA_PROFILE")
    return {"op": op, "profile": profil,
            "actor_token": os.environ.get("AWEMA_ACTOR_TOKEN"),
            "actor_credential": os.environ.get("AWEMA_ACTOR_CREDENTIAL"),
            "correlation_id": f"vault-{int(time.time() * 1000)}-{os.getpid()}"}


# --------------------------------------------------------------------------- #
# inventaire masque et hygiene (lecture seule, hors coffre)
# --------------------------------------------------------------------------- #
def inventaire_live(chemin: Path, chemin_provider: Path | None = None) -> dict:
    """Inventaire masque des secretssur disque : aucune valeur n'est lue."""
    entrees = []
    racine = Path(chemin)
    for enfant in sorted(racine.iterdir()):
        if not enfant.is_dir():
            continue
        profil = enfant.name
        for nom in (".env", "auth.json", "state.db"):
            p = enfant / nom
            if not p.exists() and not p.is_symlink():
                continue
            cible = None
            type_ = "fichier"
            if p.is_symlink():
                type_ = "lien symbolique"
                try:
                    cible = os.readlink(p)
                except OSError:
                    cible = "illisible"
            try:
                st = os.lstat(p)
                mode = oct(stat.S_IMODE(st.st_mode))
                uid, gid, taille = st.st_uid, st.st_gid, st.st_size
            except OSError:
                mode, uid, gid, taille = None, None, None, None
            entrees.append({
                "chemin": str(p), "proprietaire_profil": profil, "portee": "profil",
                "type": type_, "cible_si_lien": cible, "mode": mode,
                "uid": uid, "gid": gid, "octets": taille,
                "lisible_par_uid_partage": bool(
                    p.exists() and os.access(p, os.R_OK)),
                "valeur_lue": False,
            })
        d = enfant / "secrets"
        if d.is_dir():
            for f in sorted(d.iterdir()):
                try:
                    st = os.lstat(f)
                    mode = oct(stat.S_IMODE(st.st_mode))
                    uid, gid, taille = st.st_uid, st.st_gid, st.st_size
                except OSError:
                    mode, uid, gid, taille = None, None, None, None
                entrees.append({
                    "chemin": str(f), "proprietaire_profil": profil,
                    "portee": "profil" if "gmail" in f.name else "profil/cles",
                    "type": "fichier de secrets", "cible_si_lien": None, "mode": mode,
                    "uid": uid, "gid": gid, "octets": taille,
                    "lisible_par_uid_partage": bool(f.exists() and os.access(f, os.R_OK)),
                    "valeur_lue": False,
                })
    if chemin_provider and Path(chemin_provider).is_dir():
        for f in sorted(Path(chemin_provider).iterdir()):
            try:
                st = os.lstat(f)
                mode = oct(stat.S_IMODE(st.st_mode))
                uid, gid, taille = st.st_uid, st.st_gid, st.st_size
            except OSError:
                mode, uid, gid, taille = None, None, None, None
            entrees.append({
                "chemin": str(f), "proprietaire_profil": "plateforme (partage)",
                "portee": "service (partage entre profils)", "type": "secret fournisseur",
                "cible_si_lien": None, "mode": mode, "uid": uid, "gid": gid, "octets": taille,
                "lisible_par_uid_partage": bool(f.exists() and os.access(f, os.R_OK)),
                "valeur_lue": False,
            })
    return {"schema": "awema-inventaire-secrets-disque/1", "ts": V.maintenant(),
            "racine_balayee": str(racine), "nb_entrees": len(entrees),
            "entrees": entrees,
            "note": "Inventaire masque : chemins, modes, proprietaires et portees seulement. "
                    "Aucune valeur ni empreinte de valeur n'est produite."}


def hygiene_live(pol, chemins: list[Path]) -> dict:
    """Constats de cloisonnement hors coffre : aucun contenu n'est lu."""
    constats = []
    uids_attendus = {p["uid"] for p in (pol or {}).get("profiles", {}).values()} if pol else None
    for racine in chemins:
        p = Path(racine)
        if not p.exists():
            continue
        cibles = [p] if p.is_file() else list(p.rglob(".env")) + list(p.rglob("auth.json"))
        for c in cibles:
            try:
                st = os.lstat(c)
            except OSError:
                continue
            mode = stat.S_IMODE(st.st_mode)
            motifs = []
            if st.st_mode & 0o004:
                motifs.append("lisible par tout utilisateur (o+r)")
            if st.st_mode & 0o020:
                motifs.append("inscriptible par le groupe (g+w)")
            if st.st_mode & 0o002:
                motifs.append("inscriptible par tout utilisateur (o+w)")
            if mode != 0o600 and not c.is_symlink():
                motifs.append(f"mode {oct(mode)} : 0600 attendu pour un secret de profil")
            if c.is_symlink():
                motifs.append("lien symbolique : partage de fichier entre profils non trace")
            if uids_attendus and st.st_uid not in uids_attendus and st.st_uid != 0:
                motifs.append(f"uid {st.st_uid} hors des uid de profil declares")
            if motifs:
                constats.append({"chemin": str(c), "mode": oct(mode), "uid": st.st_uid,
                                 "motifs": motifs})
    return {"schema": "awema-hygiene-secrets/1", "ts": V.maintenant(),
            "nb_constats": len(constats), "constats": constats,
            "note": "Aucun contenu n'est lu : seuls mode, proprietaire et type de fichier sont examines."}


# --------------------------------------------------------------------------- #
def main(argv=None):
    sp = argparse.ArgumentParser(prog="awema-secret")
    sp.add_argument("--root", default=None, help="racine du socle (AWEMA_SECRET_ROOT)")
    sp.add_argument("--profil", default=None, help="profil declare (AWEMA_PROFILE)")
    sp.add_argument("--json", action="store_true", help="sortie machine")
    sub = sp.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    g = sub.add_parser("get")
    g.add_argument("--secret", required=True)
    g.add_argument("--version", type=int, default=None)
    g.add_argument("--approval-id", default=None)
    g.add_argument("--brut", action="store_true", help="ecrit la valeur brute sur stdout")
    sub.add_parser("list")
    sub.add_parser("verify")
    for nom in ("put", "rotate"):
        p = sub.add_parser(nom)
        p.add_argument("--secret", required=True)
        p.add_argument("--from", dest="source", required=True)
    r = sub.add_parser("revoke")
    r.add_argument("--secret", required=True)
    r.add_argument("--version", type=int, required=True)
    gr = sub.add_parser("grant")
    gr.add_argument("--secret", required=True)
    gr.add_argument("--to", required=True)
    gr.add_argument("--ttl", type=int, default=3600)
    rg = sub.add_parser("revoke-grant")
    rg.add_argument("--secret", required=True)
    rg.add_argument("--to", required=True)
    inv = sub.add_parser("inventaire-live")
    inv.add_argument("--chemin", default="/opt/data/profiles")
    inv.add_argument("--provider", default="/opt/data/provider-secrets")
    inv.add_argument("--out", default=None)
    hy = sub.add_parser("hygiene-live")
    hy.add_argument("--chemin", action="append", default=None)
    args = sp.parse_args(argv)
    root = V.racine(args.root)

    try:
        if args.cmd == "inventaire-live":
            obj = inventaire_live(Path(args.chemin), Path(args.provider))
            if args.out:
                Path(args.out).write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n",
                                          encoding="utf-8")
            print(json.dumps(obj, ensure_ascii=False, indent=2))
            return 0
        if args.cmd == "hygiene-live":
            chemins = [Path(c) for c in (args.chemin or ["/opt/data/profiles",
                                                         "/opt/data/provider-secrets"])]
            try:
                pol = V.politique(root)
            except V.SecretIndisponible:
                pol = None
            obj = hygiene_live(pol, chemins)
            print(json.dumps(obj, ensure_ascii=False, indent=2))
            return 0 if obj["nb_constats"] == 0 else 3

        ch = charge_de_base(args, args.cmd if args.cmd != "revoke-grant" else "revoke_grant")
        if args.cmd == "revoke-grant":
            ch["op"] = "revoke_grant"
        if args.cmd in ("get",):
            ch["secret"] = args.secret
            ch["version"] = args.version
            ch["approval_id"] = args.approval_id
        if args.cmd in ("put", "rotate"):
            src = Path(args.source)
            if not src.is_file():
                raise RefusClient(f"fichier source absent : {src}")
            ch["secret"] = args.secret
            ch["valeur_b64"] = base64.b64encode(src.read_bytes()).decode("ascii")
        if args.cmd == "revoke":
            ch["secret"] = args.secret
            ch["version"] = args.version
        if args.cmd == "grant":
            ch["secret"] = args.secret
            ch["to"] = args.to
            ch["ttl_seconds"] = args.ttl
        if args.cmd == "revoke-grant":
            ch["secret"] = args.secret
            ch["to"] = args.to
        rep = requete(root, ch)
    except (RefusClient, V.SecretRefus, V.SecretIndisponible) as exc:
        print(json.dumps({"ok": False, "error": str(exc), "refus": True}, ensure_ascii=False))
        return 2

    if args.cmd == "get" and rep.get("ok") and rep.get("valeur_b64"):
        if args.brut:
            sys.stdout.buffer.write(base64.b64decode(rep["valeur_b64"]))
            sys.stdout.buffer.flush()
            return 0
        rep = dict(rep)
        rep["valeur_b64"] = f"<{len(base64.b64decode(rep['valeur_b64']))} octets non affiches>"
    print(json.dumps(rep, ensure_ascii=False, indent=2 if not args.json else None))
    return 0 if rep.get("ok") else 2


if __name__ == "__main__":
    sys.exit(main())
