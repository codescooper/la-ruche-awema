  if type(max_calls) is not int or not 1<=max_calls<=240 or type(max_bytes) is not int or not 1<=max_bytes<=96*1024*1024:raise ValueError('run budget policy denied')
  if lease.get('calls',0)>=max_calls:raise RunBudgetExceeded('calls',lease)
  if lease.get('bytes',0)+size>max_bytes:raise RunBudgetExceeded('bytes',lease)
  lease['calls']=lease.get('calls',0)+1;lease['bytes']=lease.get('bytes',0)+size
